              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "pm.test('Response is array with nested resources', function() {",
                  "  let resp = pm.response.json();",
                  "  pm.expect(resp).to.be.an('array');",
                  "  if (resp.length > 0) {",
                  "    pm.expect(resp[0]).to.have.property('resource');",
