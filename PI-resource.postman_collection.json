{
  "info": {
    "_postman_id": "pi-resource-service-collection",
    "name": "PI Resource Service - MS-7",
    "description": "Complete API test suite for Resource Library microservice (MS-7)\nBase URL: http://localhost:8087\nAuth: OAuth2 Bearer Token from Keycloak",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth Setup",
      "item": [
        {
          "name": "[SETUP] Generate Admin Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  let resp = pm.response.json();",
                  "  pm.environment.set('access_token', resp.access_token);",
                  "  pm.environment.set('token_expires_in', resp.expires_in);",
                  "  console.log('✓ Admin token generated and saved');",
                  "} else {",
                  "  console.error('✗ Token generation failed:', pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "angular-client"
                },
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "username",
                  "value": "adminyosr@test.com"
                },
                {
                  "key": "password",
                  "value": "0000"
                },
                {
                  "key": "scope",
                  "value": "openid profile email"
                }
              ]
            },
            "url": {
              "raw": "http://localhost:8090/realms/myapp-realm/protocol/openid-connect/token",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8090",
              "path": [
                "realms",
                "myapp-realm",
                "protocol",
                "openid-connect",
                "token"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Resources",
      "item": [
        {
          "name": "GET /resources - List all",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "pm.test('Response is paginated', function() {",
                  "  let resp = pm.response.json();",
                  "  pm.expect(resp).to.have.property('content');",
                  "  pm.expect(resp).to.have.property('totalElements');",
                  "  pm.expect(resp).to.have.property('totalPages');",
                  "});",
                  "if (pm.response.json().content.length > 0) {",
                  "  pm.environment.set('resource_id', pm.response.json().content[0].id);",
                  "  pm.environment.set('category_id', pm.response.json().content[0].categoryId);",
                  "  console.log('✓ Resource ID captured:', pm.environment.get('resource_id'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8087/api/resources?page=0&size=10",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8087",
              "path": ["api", "resources"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
